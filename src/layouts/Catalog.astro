---
import "../styles/catalog.css";
import "../styles/motion.css";
import RunningHead from "../components/RunningHead.astro";
import Foot from "../components/Foot.astro";
import { SITE } from "../lib/site";
import { loadCatalog } from "../lib/catalog";

interface Props {
    /** Page title, printed before the catalog name. Omit on the front. */
    title?: string;
    description?: string;
    /** Class id of the current entry, so the page inherits its tab colour. */
    klass?: string;
    /** Original publication URL. Replaces the computed canonical URL when given. */
    canonical?: string;
}

const { title, description = SITE.description, klass, canonical: original } = Astro.props;
const catalog = await loadCatalog();
const heading = title === undefined ? SITE.name : `${title} — ${SITE.name}`;
const canonical = original ?? new URL(Astro.url.pathname, Astro.site ?? "https://hatimej.com").href;
---

<!doctype html>
<html lang="en" data-class={klass}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{heading}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta name="author" content={SITE.name} />
        <meta property="og:title" content={heading} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <link rel="icon" href="/mark.svg" type="image/svg+xml" />
        <script is:inline>
            // Set the theme before first paint so the stock never flashes.
            try {
                const stored = localStorage.getItem("catalog-theme");
                if (stored === "light" || stored === "dark") {
                    document.documentElement.dataset.theme = stored;
                }
            } catch {
                /* Storage can throw in private windows; the media query covers it. */
            }

            // The opening plays once per browser session, on whichever page loads
            // first. Reduced motion, and any browser that cannot keep the flag,
            // skip it; every other load is a return visit.
            {
                let opening = false;
                try {
                    opening =
                        !matchMedia("(prefers-reduced-motion: reduce)").matches &&
                        sessionStorage.getItem("catalog-opened") === null;
                    if (opening) {
                        sessionStorage.setItem("catalog-opened", "1");
                    }
                } catch {
                    opening = false;
                }
                document.documentElement.dataset[opening ? "opening" : "returning"] = "";
            }
        </script>
    </head>
    <body>
        <a class="skip" href="#field">Skip to the record</a>
        <RunningHead entries={catalog.entries} />
        <main id="field" class="sheet">
            <slot />
        </main>
        <Foot />
        <script>
            import "../scripts/catalog";
        </script>
        {/* Its own bundle: motion is decoration and must not be able to take the lookup down. */}
        <script>
            import "../scripts/motion";
        </script>
    </body>
</html>
